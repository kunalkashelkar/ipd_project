# ============================================================
# VulnScan Backend — Environment Configuration Template
# ============================================================
# Copy this file to .env in the backend directory or project root:
#   cp .env.example .env
# ============================================================

# ── Application ────────────────────────────────────────────
APP_NAME=VulnScan
APP_ENV=development
DEBUG=true

# ── Backend Server ─────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
BACKEND_RELOAD=true

# ── CORS ───────────────────────────────────────────────────
# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database (PostgreSQL + asyncpg) ────────────────────────
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
# IMPORTANT: Replace 'your_password_here' with your local PostgreSQL password.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vulnscan
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO_SQL=false

# ── Authentication & Security ──────────────────────────────
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-in-production-f89a74c2e19a0d8
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Redis & Celery ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# ── File Storage & Uploads ─────────────────────────────────
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=200
MAX_EXTRACTION_SIZE_MB=500
MAX_ARCHIVE_FILES=10000
ALLOWED_UPLOAD_EXTENSIONS=.zip,.jar,.java,.py,.js,.ts,.c,.cpp,.h,.hpp

# ── AI & ML Pipeline ───────────────────────────────────────
# Options: mock | gnn | hybrid
AI_MODE=mock
MODEL_STORAGE_PATH=./models
AI_DEVICE=cpu
DEFAULT_VULN_THRESHOLD=0.5
JOERN_HOME=/opt/joern
GNN_MODEL_PATH=./models/gnn/checkpoints/best_model.pt
EMBEDDING_MODEL_NAME=microsoft/codebert-base

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_DIR=./logs

# ── Frontend ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
