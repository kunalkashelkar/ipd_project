# ============================================================
# VulnScan AI Frontend — Environment Configuration
# ============================================================
# Copy this file to .env in the frontend directory:
#   cp .env.example .env
# ============================================================

# ── API Configuration ───────────────────────────────────────
# In development with Vite proxy enabled (vite.config.ts), 
# use '/api/v1' to proxy requests to http://localhost:8000/api/v1 without CORS.
# For direct API calls or production, set the full backend URL, e.g.:
# VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=/api/v1

# ── WebSocket Configuration ─────────────────────────────────
# Backend WebSocket endpoint for real-time scan progress updates
VITE_WS_URL=ws://localhost:8000

# ── Application Metadata ────────────────────────────────────
VITE_APP_TITLE=VulnScan AI — Hybrid Vulnerability Detection
VITE_APP_ENV=development
